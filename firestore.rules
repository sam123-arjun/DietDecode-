rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User Profile, Meals, Diet Plans, Reminders, and Reminder History
    // Strict Per-User Authorization: Users can only read and write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
